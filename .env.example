# Энэ файлд зөвхөн жишээ утга байна. Жинхэнэ token, дансны дугаар энд бичихгүй.
# Жинхэнэ утгыг Railway > Variables-д (локалд .env файлд) хийнэ.

# ===== СЕРВЕР =====
PORT=3000
# Сайтын нийтийн хаяг (заавал биш — вэб захиалгын Discord мэдэгдэл дэх линкэнд)
PUBLIC_URL=https://your-domain.example

# ===== FACEBOOK MESSENGER / INSTAGRAM =====
# FB App > Messenger > Settings-ээс авна
FB_PAGE_ACCESS_TOKEN=your_page_access_token_here
# Webhook баталгаажуулахад өөрөө зохиосон нууц үг (юу ч байж болно)
FB_VERIFY_TOKEN=your_verify_token_here
# Баглааны зургийн FB цомгийн линк (заавал биш)
FB_ALBUM_URL=

# ===== DISCORD =====
# Discord Developer Portal > Bot-оос авна
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_id_here
# Сувгуудын ID (суваг дээр баруун товч > Copy Channel ID)
DISCORD_ORDER_CHANNEL_ID=000000000000000000
DISCORD_HAALT_CHANNEL_ID=000000000000000000
DISCORD_WARNING_CHANNEL_ID=000000000000000000
DISCORD_SALARY_CHANNEL_ID=000000000000000000
DISCORD_BARAA_CHANNEL_ID=000000000000000000
DISCORD_ZARDAL_CHANNEL_ID=000000000000000000
# Өдрийн тайлангийн суваг (автомат тайлан одоогоор унтраалттай, заавал биш)
DISCORD_REPORT_CHANNEL_ID=
# Бараа таталтын 7 хоногийн сануулгад mention хийх role-ийн ID (хоосон бол mention-гүй)
DISCORD_BARAA_ROLE_ID=

# ===== GOOGLE SHEETS =====
# Үүсгэсэн Sheet-ийн URL дундах урт ID
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Service account JSON-оос
GOOGLE_SERVICE_EMAIL=flower-bot@your-project.iam.gserviceaccount.com
# JSON доторх private_key-г бүтнээр нь хашилтанд хийнэ (\n-ийг хэвээр)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# ===== AI (Anthropic) =====
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Чатын модель (заавал биш — хоосон бол кодод заасан модель)
AI_CHAT_MODEL=
# /hansh-аар ханш тохируулаагүй үед хэрэглэх юанийн ханш (заавал биш)
CNY_RATE=

# ===== GMAIL (ХасБанкны гүйлгээ унших) =====
# Банкны и-мэйл ирдэг Gmail хаяг + App Password (2FA асаагаад үүсгэнэ)
# Gmail-д IMAP асаах ёстой: Settings > See all settings > Forwarding and POP/IMAP
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Банкны и-мэйлд өгсөн label-ийн нэр (default: bank-transaction)
GMAIL_BANK_LABEL=bank-transaction

# ===== YAHOO (Хаан банкны мэдэгдэл өөр хүний Yahoo-д ирдэг) =====
# Зөвхөн YAHOO_SHOP_ACCOUNT дансны гүйлгээг уншина. Шууданг өөрчлөхгүй.
YAHOO_USER=someone@yahoo.com
YAHOO_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Хэд хэдэн данс байж болно, ":нэр"-ээр үүргийг нь заана (Данс = шилжүүлэг, Бэлэн = бэлэн тушаалт)
YAHOO_SHOP_ACCOUNT=5011111111:Данс,5022222222:Бэлэн
# YAHOO_FROM=   (заавал биш: Хаан банкны илгээгчийн хаяг)
# YAHOO_FOLDER=INBOX

# ===== БАНК, ТУЛГАЛТ =====
# Дэлгүүрийн өөрийн дансууд (таслалаар) — хоорондын шилжүүлгийг орлого/зарлагад тооцохгүй
BANK_OWN_ACCOUNTS=5011111111,5022222222
# Пос-оор орсон мөнгөнөөс банкны авдаг шимтгэл, % (default 1)
# POS_FEE_PERCENT=1
