# ===== СЕРВЕР =====
PORT=3000

# ===== FACEBOOK MESSENGER =====
# FB App > Messenger > Settings-ээс авна
FB_PAGE_ACCESS_TOKEN=your_page_access_token_here
# Webhook баталгаажуулахад өөрөө зохиосон нууц үг (юу ч байж болно)
FB_VERIFY_TOKEN=tsetseg_secret_2025
FB_APP_SECRET=your_app_secret_here

# ===== DISCORD =====
# Discord Developer Portal > Bot-оос авна
DISCORD_ORDER_CHANNEL_ID      = #захиалга
DISCORD_REPORT_CHANNEL_ID     = #өдрийн-тайлан
DISCORD_SALARY_CHANNEL_ID     = #цалин
DISCORD_IRTS_CHANNEL_ID       = #ирц
DISCORD_WARNING_CHANNEL_ID    = #анхааруулга
DISCORD_HAALT_CHANNEL_ID      = #өдрийн-хаалт
DISCORD_ZARDAL_CHANNEL_ID     = #зардал
# Бараа таталтын 7 хоногийн сануулгад mention хийх role-ийн ID (заавал биш)
DISCORD_BARAA_ROLE_ID=

# ===== GMAIL (банкны гүйлгээ унших) =====
# Банкны и-мэйл ирдэг Gmail хаяг + App Password (2FA асаагаад үүсгэнэ)
# Gmail-д IMAP асаах ёстой: Settings > See all settings > Forwarding and POP/IMAP
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Банкны и-мэйлд өгсөн label-ийн нэр (default: bank-transaction)
GMAIL_BANK_LABEL=bank-transaction
# Дэлгүүрийн өөрийн дансууд (таслалаар) — хоорондын шилжүүлгийг орлого/зарлагад тооцохгүй
# Пос-оор орсон мөнгөнөөс банкны авдаг шимтгэл, % (тулгалтад). Default 1
# POS_FEE_PERCENT=1

# ===== YAHOO (Хаан банкны мэдэгдэл өөр хүний Yahoo-д ирдэг бол) =====
# Зөвхөн Хаан банкнаас ирсэн, YAHOO_SHOP_ACCOUNT дансны гүйлгээг уншина. Шууданг өөрчлөхгүй.
YAHOO_USER=someone@yahoo.com
YAHOO_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Хэд хэдэн данс байж болно, ":нэр"-ээр үүргийг нь заана (Данс = шилжүүлэг, Бэлэн = бэлэн тушаалт)
YAHOO_SHOP_ACCOUNT=5011111111:Данс,5022222222:Бэлэн
# YAHOO_FROM=khanbank   (илгээгчийн хаягт орсон үг)
# YAHOO_FOLDER=INBOX
BANK_OWN_ACCOUNTS=дансны_дугаар1,дансны_дугаар2

# ===== GOOGLE SHEETS =====
# Үүсгэсэн Sheet-ийн URL дундах урт ID
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Service account JSON-оос
GOOGLE_SERVICE_EMAIL=flower-bot@your-project.iam.gserviceaccount.com
# JSON доторх private_key-г бүтнээр нь хашилтанд хийнэ (\n-ийг хэвээр)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
